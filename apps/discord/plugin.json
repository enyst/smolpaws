{
  "name": "discord",
  "label": "Discord",
  "kind": "standalone",
  "version": "2.0.0",
  "description": "Standalone Discord Gateway bridge for the durable Message Relay and Delivery Dispatcher path.",
  "requiredEnv": [
    "DISCORD_BOT_TOKEN"
  ],
  "secretEnv": [
