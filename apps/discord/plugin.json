    "DISCORD_ALLOWED_GUILDS",
    "DISCORD_ALLOWED_CHANNELS",
    "DISCORD_ALLOWED_USER_IDS",
    "SMOLPAWS_RELAY_SERVER_URL",
    "SMOLPAWS_RELAY_SERVER_API_KEY"
  ]
}
